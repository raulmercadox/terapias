// Sistema Terapias — esquema multitenant (PostgreSQL)
// Cada Centro (empresa) tiene sus sedes y usuarios; el resto de los datos
// cuelga de una sede, así que el aislamiento entre centros pasa por Sede.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Rol {
  SUPERADMIN // usuario de plataforma: da de alta centros, no pertenece a ninguno
  ADMINISTRADOR
  COORDINADOR
  USUARIO
}

enum Sexo {
  M
  F
}

enum EstadoPaciente {
  ACTIVO
  BAJA
}

enum Programa {
  ESCOLAR
  INTERDIARIO
  TERAPIAS
}

enum Vinculo {
  MADRE
  PADRE
  APODERADO
  OTRO
}

enum TipoCita {
  CONSULTA
  EVALUACION
  SESION
}

enum EstadoCita {
  AGENDADA
  ATENDIDA
  CANCELADA
}

enum Asistencia {
  PENDIENTE
  ASISTIO
  FALTO
  TARDANZA
}

enum EstadoPaquete {
  ACTIVO
  COMPLETADO
  VENCIDO
  ANULADO
}

enum ConceptoPago {
  MATRICULA
  MATERIALES
  MENSUALIDAD
  PAQUETE_SESIONES
  EVALUACION
  OTRO
}

enum MetodoPago {
  EFECTIVO
  YAPE
  PLIN
  TRANSFERENCIA
  TARJETA
}

// ENTRADA: el interesado busca al centro (llama, escribe, viene a evaluación).
// SALIDA: el centro lo busca a él para darle seguimiento.
enum DireccionInteraccion {
  ENTRADA
  SALIDA
}

enum CanalInteraccion {
  LLAMADA
  WHATSAPP
  VISITA
  EVALUACION
  CORREO
  REDES
  OTRO
}

// Solo para SALIDA: si no se logró hablar con él, sigue pendiente en la bandeja.
enum ResultadoSalida {
  CONTACTADO
  SIN_RESPUESTA
}

// ─────────────────────────────────────────────────────────────
// Núcleo: Centros, Sedes y Usuarios
// ─────────────────────────────────────────────────────────────

// Centro de terapias (tenant). Su `codigo` es lo que se escribe en el campo
// "Empresa" del login; `nombre` y `subtitulo` son la marca en pantallas.
model Centro {
  id        String   @id @default(cuid())
  codigo    String   @unique // minúsculas, números y guiones
  nombre    String
  subtitulo String?
  activo    Boolean  @default(true) // inactivo = nadie del centro puede entrar
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sedes         Sede[]
  usuarios      User[]
  configuracion Configuracion?
  plantillas    PlantillaFicha[]
}

// Cómo se calcula el plazo para pagar un paquete (periodo de gracia).
enum TipoGracia {
  PORCENTAJE // % de los días entre la primera y la última sesión originales
  DIAS // días fijos desde la primera sesión
}

// Configuración de cobranza del centro: una fila por centro y vale para todas
// sus sedes. Sin fila rigen los valores por defecto (ver src/lib/configuracion.ts).
model Configuracion {
  centroId       String     @id
  graciaTipo     TipoGracia @default(PORCENTAJE)
  graciaValor    Int        @default(50)
  // Con cuántos días de anticipación un pago cuenta como "por vencer".
  diasAvisoCobro Int        @default(7)
  updatedAt      DateTime   @updatedAt

  centro Centro @relation(fields: [centroId], references: [id], onDelete: Cascade)
}

// Las tres fichas clínicas del sistema.
enum TipoFicha {
  HISTORIA
  EVALUACION
  INFORME
}

// Estructura de una ficha clínica, editable por centro: es lo que permite que
// el mismo sistema sirva a terapia psicológica y a terapia física. Una fila por
// centro y tipo; sin fila rige la plantilla base psicológica.
// La forma del Json está en src/lib/fichas/tipos.ts.
model PlantillaFicha {
  id        String    @id @default(cuid())
  centroId  String
  tipo      TipoFicha
  // "psicologica" | "fisica" | "personalizada": de qué base salió.
  base      String    @default("psicologica")
  // Sube en cada guardado. La evaluación y el informe copian este número junto
  // con la estructura, para avisar cuando la ficha quedó atrás de la plantilla.
  version   Int       @default(1)
  secciones Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  centro Centro @relation(fields: [centroId], references: [id], onDelete: Cascade)

  @@unique([centroId, tipo])
}

model Sede {
  id                   String   @id @default(cuid())
  centroId             String
  nombre               String
  direccion            String?
  telefono             String?
  activo               Boolean  @default(true)
  // Horario laboral (atención): rango de atención y días hábiles.
  horaApertura         String   @default("09:00") // "HH:mm"
  horaCierre           String   @default("13:00") // "HH:mm"
  // Refrigerio opcional: si está configurado, ninguna sesión puede invadirlo.
  // Ambos campos van juntos (los dos con valor o los dos en null).
  refrigerioInicio     String? // "HH:mm"
  refrigerioFin        String? // "HH:mm"
  diasLaborales        Int[]    @default([1, 2, 3, 4, 5, 6]) // getDay(): 0=Dom..6=Sáb
  // Paso predeterminado de la grilla del calendario al agendar (minutos entre
  // horas de inicio ofrecidas). En el calendario se puede cambiar al vuelo;
  // esto solo define el valor inicial. Debe estar en intervalosCalendario.
  intervaloCalendario  Int      @default(30)
  // Opciones de paso que ofrece el selector "Intervalo" del calendario.
  // Editable por sede en Configuración › Horario (múltiplos de 5, 5–120).
  intervalosCalendario Int[]    @default([15, 30, 45, 60])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  centro            Centro            @relation(fields: [centroId], references: [id])
  usuarios          UserSede[]
  terapeutas        Terapeuta[]
  pacientes         Paciente[]
  paquetes          Paquete[]
  citas             Cita[]
  pagos             Pago[]
  programas         ProgramaTerapia[]
  feriados          Feriado[]
  evaluaciones      Evaluacion[]
  historiasClinicas HistoriaClinica[]
  informesAvance    InformeAvance[]
  interacciones     Interaccion[]

  @@unique([centroId, nombre])
}

model User {
  id           String     @id @default(cuid())
  // Null solo para SUPERADMIN. Postgres no aplica el @@unique con NULL, así
  // que la unicidad de `usuario` entre superadmins se valida en código.
  centroId     String?
  nombre       String
  usuario      String // con lo que inicia sesión; único dentro del centro
  email        String?
  passwordHash String
  rol          Rol        @default(USUARIO)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  centro       Centro?    @relation(fields: [centroId], references: [id])
  // Sedes asignadas (Coordinador: varias; Usuario: una). Admin ve todas las de su centro, sin filas.
  sedes        UserSede[]

  @@unique([centroId, usuario])
}

model UserSede {
  userId String
  sedeId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sede   Sede   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@id([userId, sedeId])
  @@index([sedeId])
}

// Profesionales que atienden (licenciadas/terapeutas). Independiente del login.
model Terapeuta {
  id           String   @id @default(cuid())
  sedeId       String
  nombres      String
  apellidos    String
  especialidad String?
  telefono     String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sede           Sede            @relation(fields: [sedeId], references: [id])
  citas          Cita[]
  evaluaciones   Evaluacion[]
  informesAvance InformeAvance[]

  @@index([sedeId])
}

// ─────────────────────────────────────────────────────────────
// Pacientes y Apoderados
// ─────────────────────────────────────────────────────────────

model Paciente {
  id              String         @id @default(cuid())
  sedeId          String
  nombres         String
  apellidoPaterno String
  apellidoMaterno String?
  dni             String?
  fechaNacimiento DateTime?
  sexo            Sexo?
  telefono        String?
  correo          String?
  direccion       String?
  distrito        String?
  fotoUrl         String?
  programa        Programa       @default(TERAPIAS)
  diagnostico     String?
  estado          EstadoPaciente @default(ACTIVO)
  observaciones   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  sede            Sede             @relation(fields: [sedeId], references: [id])
  apoderados      Apoderado[]
  paquetes        Paquete[]
  citas           Cita[]
  pagos           Pago[]
  evaluaciones    Evaluacion[]
  historiaClinica HistoriaClinica?
  informesAvance  InformeAvance[]
  interacciones   Interaccion[]

  @@index([sedeId])
  @@index([dni])
}

// Ficha de Evaluación inicial: la aplica un especialista cuando el paciente
// llega por primera vez. Réplica del formato impreso del centro (secciones
// I–X) y concluye con el tipo de programa recomendado.
model Evaluacion {
  id          String   @id @default(cuid())
  sedeId      String
  pacienteId  String
  evaluadorId String?
  fecha       DateTime @default(now())

  // I. Datos complementarios (nombres, edad, sexo, dirección… viven en Paciente)
  lugarNacimiento String?
  numeroHermanos  String?
  nivelAcademico  String?
  centroEducativo String?

  // II. Relación del menor con las personas que convive
  conviveMadre    Boolean @default(false)
  convivePadre    Boolean @default(false)
  conviveHermanos Boolean @default(false)
  conviveOtros    String?
  relacionDetalle String?

  // III. Historia personal
  diagnostico          String?
  medicacion           String?
  terapiasRealiza      String?
  dificultadesDormir   String?
  dificultadesComer    String?
  dificultadesPresenta String?

  // IV. Antecedentes escolares
  preescolar            String?
  escolar               String?
  comportamientoAula    String?
  rendimientoEscolar    String?
  dificultadesEscolares String?

  // V–IX. Checklists de áreas, keyed por id de ítem del catálogo
  // (pacientes/[id]/evaluaciones/ficha.ts):
  // { [itemId]: { valor?: "I"|"P"|"L"|"SI"|"NO", obs?: string } }
  resultados Json @default("{}")

  // VI. Modalidad de lenguaje: "VERBAL" | "NO_VERBAL"
  modalidadLenguaje    String?
  // VIII–IX. Observaciones libres de área
  observacionSensorial String? // hipo – híper sensibilidad
  observacionMotriz    String? // presenta problemas motrices

  // X. Observación durante la evaluación
  observacionGeneral String?

  // Resultado de la evaluación
  programaRecomendado Programa?
  recomendaciones     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sede        Sede         @relation(fields: [sedeId], references: [id])
  paciente    Paciente     @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  evaluador   Terapeuta?   @relation(fields: [evaluadorId], references: [id])
  interaccion Interaccion?

  @@index([pacienteId, fecha])
  @@index([sedeId])
}

// Historia Clínica: única por paciente. Su estructura ya no vive en columnas
// fijas sino en la plantilla HISTORIA del centro (ver src/lib/fichas): así el
// mismo sistema sirve a terapia psicológica y física. `valores` guarda lo
// registrado, indexado por id de campo de la plantilla. Es un expediente vivo:
// sigue la plantilla vigente, y lo registrado con campos que luego se quitaron
// nunca se borra (se muestra aparte).
model HistoriaClinica {
  id         String   @id @default(cuid())
  sedeId     String
  pacienteId String   @unique
  fecha      DateTime @default(now())
  valores    Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sede     Sede     @relation(fields: [sedeId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([sedeId])
}

// Informe de Avance: varios por paciente (a diferencia de la Historia Clínica).
// Réplica del formato impreso del centro: secciones con ítems calificados en
// EI / EP / LE, más recomendaciones libres al final.
model InformeAvance {
  id          String   @id @default(cuid())
  sedeId      String
  pacienteId  String
  evaluadorId String?
  fecha       DateTime @default(now())

  // Secciones con sus ítems. A diferencia de Evaluacion.resultados —que solo
  // guarda valores contra el catálogo fijo de ficha.ts— aquí viaja también el
  // texto de cada ítem, porque es editable en cada informe:
  // [{ id, titulo, items: [{ id, label, valor?: "EI"|"EP"|"LE" }] }]
  // La plantilla inicial vive en pacientes/[id]/informes/informe.ts
  secciones Json @default("[]")

  recomendaciones String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sede      Sede       @relation(fields: [sedeId], references: [id])
  paciente  Paciente   @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  evaluador Terapeuta? @relation(fields: [evaluadorId], references: [id])

  @@index([pacienteId, fecha])
  @@index([sedeId])
}

model Apoderado {
  id         String   @id @default(cuid())
  pacienteId String
  nombres    String
  apellidos  String?
  dni        String?
  telefono   String?
  correo     String?
  vinculo    Vinculo  @default(APODERADO)
  principal  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
}

// ─────────────────────────────────────────────────────────────
// Paquetes de sesiones y Citas/Agenda
// ─────────────────────────────────────────────────────────────

model Paquete {
  id               String        @id @default(cuid())
  sedeId           String
  pacienteId       String
  programaId       String?
  totalSesiones    Int           @default(12)
  frecuenciaSemana Int           @default(3)
  // Plantilla del horario semanal: [{ "dia": 1, "hora": "09:00" }, ...] (para renovar).
  horarioSemanal   Json?
  precio           Decimal       @db.Decimal(10, 2)
  fechaInicio      DateTime?
  fechaFin         DateTime?
  estado           EstadoPaquete @default(ACTIVO)
  observacion      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sede     Sede             @relation(fields: [sedeId], references: [id])
  paciente Paciente         @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  programa ProgramaTerapia? @relation(fields: [programaId], references: [id])
  citas    Cita[]
  pagos    Pago[]

  @@index([sedeId])
  @@index([pacienteId])
  @@index([programaId])
}

model Cita {
  id                  String     @id @default(cuid())
  sedeId              String
  pacienteId          String
  terapeutaId         String?
  paqueteId           String?
  numeroSesion        Int?
  fecha               DateTime
  horaInicio          String // "09:00"
  horaFin             String // "09:45"
  tipo                TipoCita   @default(SESION)
  estado              EstadoCita @default(AGENDADA)
  asistencia          Asistencia @default(PENDIENTE)
  terapiaRealizada    String?
  observacion         String?
  recordatorioEnviado Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  sede          Sede                @relation(fields: [sedeId], references: [id])
  paciente      Paciente            @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  terapeuta     Terapeuta?          @relation(fields: [terapeutaId], references: [id])
  paquete       Paquete?            @relation(fields: [paqueteId], references: [id], onDelete: SetNull)
  observaciones ObservacionSesion[]

  @@index([sedeId, fecha])
  @@index([pacienteId])
  @@index([terapeutaId, fecha])
  @@index([paqueteId])
}

// Historial inmutable de observaciones del seguimiento de la sesión.
// Cada registro es una nota fechada que no se edita ni se borra: queda como bitácora.
model ObservacionSesion {
  id        String   @id @default(cuid())
  citaId    String
  texto     String
  autor     String? // nombre del usuario que registró la observación
  createdAt DateTime @default(now())

  cita Cita @relation(fields: [citaId], references: [id], onDelete: Cascade)

  @@index([citaId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Configuración de agenda por sede: programas y feriados
// ─────────────────────────────────────────────────────────────

// Programa de terapia configurable por sede. Define la duración de sus sesiones.
// (Independiente del enum Programa usado en Paciente.)
model ProgramaTerapia {
  id           String   @id @default(cuid())
  sedeId       String
  nombre       String
  duracionMin  Int      @default(45)
  // Cupo máximo de pacientes por franja (terapeuta + día + hora).
  // 1 = terapia individual; >1 = terapia grupal.
  maxPacientes Int      @default(1)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sede     Sede      @relation(fields: [sedeId], references: [id])
  paquetes Paquete[]

  @@unique([sedeId, nombre])
  @@index([sedeId])
}

// Feriados por sede: días no disponibles para sesiones (se saltan al generar).
model Feriado {
  id          String   @id @default(cuid())
  sedeId      String
  fecha       DateTime // anclado a medianoche local
  descripcion String?
  createdAt   DateTime @default(now())

  sede Sede @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@unique([sedeId, fecha])
  @@index([sedeId, fecha])
}

// ─────────────────────────────────────────────────────────────
// Pagos y Recibos internos
// ─────────────────────────────────────────────────────────────

model Pago {
  id           String       @id @default(cuid())
  sedeId       String
  pacienteId   String
  paqueteId    String?
  numeroRecibo String // correlativo por sede, ej "SJL-000001"
  concepto     ConceptoPago @default(PAQUETE_SESIONES)
  descripcion  String?
  monto        Decimal      @db.Decimal(10, 2)
  saldo        Decimal      @default(0) @db.Decimal(10, 2)
  metodoPago   MetodoPago   @default(EFECTIVO)
  referencia   String?
  fechaPago    DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  sede     Sede     @relation(fields: [sedeId], references: [id])
  paciente Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  paquete  Paquete? @relation(fields: [paqueteId], references: [id], onDelete: SetNull)

  @@unique([sedeId, numeroRecibo])
  @@index([sedeId, fechaPago])
  @@index([pacienteId])
}

// ─────────────────────────────────────────────────────────────
// Seguimiento de interesados
// ─────────────────────────────────────────────────────────────

// Bitácora de contactos con el interesado (el paciente o su familia). Un
// paciente queda pendiente en la bandeja de seguimiento mientras tenga una
// ENTRADA posterior a su última SALIDA con resultado CONTACTADO.
// La regla vive en seguimiento/seguimiento.ts.
model Interaccion {
  id           String               @id @default(cuid())
  sedeId       String
  pacienteId   String
  direccion    DireccionInteraccion
  canal        CanalInteraccion     @default(LLAMADA)
  fecha        DateTime             @default(now()) // fecha y hora reales del contacto
  resultado    ResultadoSalida? // solo SALIDA
  nota         String?
  autor        String? // nombre del usuario que la registró
  // Entrada creada sola al registrar la ficha de evaluación de un paciente
  // sin paquete. Se borra con la evaluación.
  evaluacionId String?              @unique
  createdAt    DateTime             @default(now())

  sede       Sede        @relation(fields: [sedeId], references: [id])
  paciente   Paciente    @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  evaluacion Evaluacion? @relation(fields: [evaluacionId], references: [id], onDelete: Cascade)

  @@index([sedeId, direccion, fecha])
  @@index([pacienteId, fecha])
}
