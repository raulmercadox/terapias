# Copia este archivo a .env y completa los valores
# Desarrollo (docker compose up -d): postgresql://terapias:terapias@localhost:5434/terapias?schema=public
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:5432/terapias?schema=public"
AUTH_SECRET="genera-uno-con: openssl rand -base64 32"
AUTH_TRUST_HOST="true"
# Clave inicial del superadmin que crea el seed (por defecto admin123).
# SEED_SUPERADMIN_PASSWORD="cambia-esto"
