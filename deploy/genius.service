[Unit]
Description=B-Genius Next.js app
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/genius
Environment=NODE_ENV=production
ExecStart=/opt/genius/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
